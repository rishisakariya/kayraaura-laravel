        {
          "name": "Razorpay Webhook - Payment Captured",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Razorpay-Signature",
                "value": "{{webhook_signature}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"{{razorpay_payment_id}}\",\n        \"entity\": \"payment\",\n        \"amount\": 118000,\n        \"currency\": \"INR\",\n        \"status\": \"captured\",\n        \"order_id\": \"{{razorpay_order_id}}\",\n        \"method\": \"upi\",\n        \"email\": \"aayush@example.com\",\n        \"contact\": \"9876543210\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/razorpay/webhook",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "razorpay",
                "webhook"
              ]
            }
          },
          "response": []
        },

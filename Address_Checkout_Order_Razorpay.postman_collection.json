                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Razorpay-Signature",
                "value": "{{webhook_signature}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.failed\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"{{razorpay_payment_id}}\",\n        \"entity\": \"payment\",\n        \"amount\": 118000,\n        \"currency\": \"INR\",\n        \"status\": \"failed\",\n        \"order_id\": \"{{razorpay_order_id}}\",\n        \"method\": \"card\",\n        \"email\": \"aayush@example.com\",\n        \"contact\": \"9876543210\",\n        \"error_code\": \"BAD_REQUEST_ERROR\",\n        \"error_description\": \"Payment failed\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },

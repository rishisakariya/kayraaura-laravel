APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

DELHIVERY_ENABLED=true
DELHIVERY_ENV=staging
DELHIVERY_MOCK=false
DELHIVERY_TOKEN=
DELHIVERY_CLIENT_NAME=
DELHIVERY_PICKUP_LOCATION=
DELHIVERY_SELLER_GST_TIN=
DELHIVERY_DEFAULT_HSN_CODE=
DELHIVERY_DEFAULT_LENGTH_CM=10
DELHIVERY_DEFAULT_WIDTH_CM=10
DELHIVERY_DEFAULT_HEIGHT_CM=5
DELHIVERY_SYNC_CACHE_MINUTES=15
DELHIVERY_WEBHOOK_SECRET=
DELHIVERY_LABEL_PDF_SIZE=4R

SMS_DRIVER=whatsapp

WHATSAPP_CLOUD_API_VERSION=v25.0
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TEMPLATE_LANGUAGE=en_US
WHATSAPP_CLOUD_COUNTRY_CODE=91
WHATSAPP_CLOUD_BODY_PARAMETERS=otp
WHATSAPP_CLOUD_OTP_BUTTON_ENABLED=true
WHATSAPP_CLOUD_OTP_BUTTON_SUB_TYPE=url
WHATSAPP_CLOUD_OTP_BUTTON_INDEX=0
WHATSAPP_CLOUD_DEFAULT_TEMPLATE=
WHATSAPP_CLOUD_FORGOT_PASSWORD_TEMPLATE=
WHATSAPP_CLOUD_COD_ORDER_TEMPLATE=

# Legacy MSG91 SMS config is kept for future use.
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=

SHIPROCKET_ENV=staging
SHIPROCKET_ENABLED=false
SHIPROCKET_MOCK=true

# --- Staging (SHIPROCKET_ENV=staging) ---
SHIPROCKET_STAGING_EMAIL=
SHIPROCKET_STAGING_PASSWORD=
SHIPROCKET_STAGING_PICKUP_LOCATION=
SHIPROCKET_STAGING_CHANNEL_ID=
SHIPROCKET_STAGING_COURIER_ID=
# SHIPROCKET_STAGING_BASE_URL=https://apiv2.shiprocket.in

# --- Production (SHIPROCKET_ENV=production) ---
SHIPROCKET_PRODUCTION_EMAIL=
SHIPROCKET_PRODUCTION_PASSWORD=
SHIPROCKET_PRODUCTION_PICKUP_LOCATION=
SHIPROCKET_PRODUCTION_CHANNEL_ID=
SHIPROCKET_PRODUCTION_COURIER_ID=
# SHIPROCKET_PRODUCTION_BASE_URL=https://apiv2.shiprocket.in

# Legacy fallback (used if staging/production vars above are empty)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_COURIER_ID=

SHIPROCKET_TOKEN_CACHE_MINUTES=518400
SHIPROCKET_SYNC_CACHE_MINUTES=15

# Used only for Shiprocket reverse pickup (returns). You can keep these empty for forward-only usage.
SHIPROCKET_SELLER_NAME=Seller
SHIPROCKET_SELLER_ADDRESS_LINE_1=
SHIPROCKET_SELLER_ADDRESS_LINE_2=
SHIPROCKET_SELLER_LANDMARK=
SHIPROCKET_SELLER_CITY=
SHIPROCKET_SELLER_STATE=
SHIPROCKET_SELLER_POSTAL_CODE=

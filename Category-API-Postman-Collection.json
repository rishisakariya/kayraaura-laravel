{
	"info": {
		"_postman_id": "kayraaura-category-api",
		"name": "Kayra Aura - Category API",
		"description": "Complete API collection for testing Category Management endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.data.token) {",
									"        pm.collectionVariables.set('token', response.data.token);",
									"        pm.collectionVariables.set('adminId', response.data.user.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@kayraaura.com\",\n    \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/cpanel/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cpanel",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Categories",
			"item": [
				{
					"name": "List Categories",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/cpanel/categories?search=&is_active=&per_page=15",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cpanel",
								"categories"
							],
							"query": [
								{
									"key": "search",
									"value": "",
									"description": "Search by name or description"
								},
								{
									"key": "is_active",
									"value": "",
									"description": "Filter by active status (0/1)"
								},
								{
									"key": "per_page",
									"value": "15",
									"description": "Items per page"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Category",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"edit_value\": 0,\n    \"name\": \"Rings\",\n    \"description\": \"Beautiful finger rings collection\",\n    \"parent_id\": null,\n    \"sort_order\": 1,\n    \"is_active\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/cpanel/categories",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cpanel",
								"categories"
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Subcategory",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"edit_value\": 0,\n    \"name\": \"Diamond Rings\",\n    \"description\": \"Luxury diamond rings\",\n    \"parent_id\": 1,\n    \"sort_order\": 1,\n    \"is_active\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/cpanel/categories",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cpanel",
								"categories"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Single Category",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/cpanel/categories/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cpanel",
								"categories",
								"1"
							]
						}
					},
					"response": []
				},
				{
					"name": "Update Category",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"edit_value\": 1,\n    \"name\": \"Wedding Rings\",\n    \"description\": \"Elegant wedding rings collection\",\n    \"sort_order\": 2,\n    \"is_active\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/cpanel/categories",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cpanel",
								"categories"
							]
						}
					},
					"response": []
				},
				{
					"name": "Delete Category",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/cpanel/categories/2",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cpanel",
								"categories",
								"2"
							]
						}
					},
					"response": []
				}
			]
		}
	]
}

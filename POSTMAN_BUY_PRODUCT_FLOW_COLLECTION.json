            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Buyer\",\n  \"email\": \"{{customer_email}}\",\n  \"phone\": \"9876543210\",\n  \"address_line_1\": \"101 Test Street\",\n  \"address_line_2\": \"Near Ring Road\",\n  \"city\": \"Surat\",\n  \"state\": \"Gujarat\",\n  \"postal_code\": \"395006\",\n  \"country\": \"India\",\n  \"landmark\": \"Postman Landmark\",\n  \"address_type\": \"home\",\n  \"is_default\": true\n}"
            },

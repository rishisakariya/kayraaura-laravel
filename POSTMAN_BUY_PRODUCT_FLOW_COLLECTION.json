        {
          "name": "List Products And Auto Pick First Available Size",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const products = json.data || [];",
                  "let pickedProduct = null;",
                  "let pickedSize = null;",
                  "for (const product of products) {",
                  "  const sizes = product.sizes || [];",
                  "  pickedSize = sizes.find(size => Number(size.quantity) > 0) || sizes[0];",
                  "  if (pickedSize) {",
                  "    pickedProduct = product;",
                  "    break;",
                  "  }",
                  "}",
                  "if (pickedProduct && pickedSize) {",
                  "  pm.collectionVariables.set('product_slug', pickedProduct.slug);",
                  "  pm.collectionVariables.set('product_size_id', pickedSize.id);",
                  "}",
                  "pm.test('Product size selected', function () {",
                  "  pm.expect(pm.collectionVariables.get('product_size_id')).to.not.eql('');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": "Fetches products and saves the first available product_size_id. If this does not find one, manually set product_size_id in collection variables."
          },
          "response": []
        },

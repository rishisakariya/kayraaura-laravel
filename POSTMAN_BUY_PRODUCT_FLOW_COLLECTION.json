                  "if (razorpay && razorpay.order_id) {",
                  "  pm.collectionVariables.set('razorpay_order_id', razorpay.order_id);",
                  "}",
                  "pm.test('Online order created', function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "});"
